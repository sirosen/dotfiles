#!/bin/bash
set -e
cd "$(dirname "$0")"

DOCKER_SANDBOX_VERSION="0.39.0"
VIM_VERSION="9.1.0443"
NEOVIM_VERSION="0.11.3"
HELIX_VERSION="25.07.1"
FNM_VERSION="1.33.1"
SHFMT_VERSION="3.8.0"
SHELLCHECK_VERSION="0.9.0"
CHEAT_VERSION='4.2.2'
GH_VERSION="2.99.0"
MILLER_VERSION="6.3.0"
YQ_VERSION="4.35.1"
KUBECTL_VERSION="1.24.2"
HELM_VERSION="3.9.0"
SPOTIFYD_VERSION="0.4.2"
TURBOLIFT_VERSION="2.2.0"
TYPST_VERSION="0.15.1"
TERRAFORM_VERSION="1.7.5"
VALE_VERSION="3.12.0"

print_usage () {
  echo "USAGE: update-personal-bin [-h|--help] [--verbose] [--npm] [--python] [--binary] [--go] [--all]"
}

vecho () {
  if [ "$verbose" -eq 1 ]; then
    echo "$@"
  fi
}

TMPDIR=""
_CLEANUP_DIRS=()
_cleanup() {
  for dirname in "${_CLEANUP_DIRS[@]}"; do
    rm -r "$dirname"
  done
}
trap _cleanup EXIT

setup_tmpdir () {
  TMPDIR="$(mktemp -d)"
  _CLEANUP_DIRS+=("$TMPDIR")
}

curldown () {
  local src=""
  local dst=""
  local github_release_base=""

  while [ $# -gt 0 ]; do
    case "$1" in
      "--github-release")
        shift 1
        github_release_base="$1"
        ;;
      *)
        if [ -z "$src" ]; then
          src="$1"
        elif [ -z "$dst" ]; then
          dst="$1"
        else
          echo "bad curldown usage" >&2
          return 2
        fi
        ;;
    esac
    shift 1
  done

  if [ -z "$src" ]; then
    echo "bad curldown usage" >&2
    return 2
  fi

  if [ -n "$github_release_base" ]; then
    src="https://github.com/${github_release_base}/releases/download/${src}"
  fi

  opts=(-LsSf -m 60)
  if [ -n "$dst" ]; then
    opts+=(-o "$dst")
  fi
  curl "${opts[@]}" "$src"
}

run-pip-install () {
  local add_args="-q"
  if [ "$verbose" -eq 1 ]; then
    add_args=""
  fi
  venv="$1"
  shift 1
  if [ ! -d "$venv" ]; then
    python -m venv "$venv"
  fi
  # shellcheck disable=SC2086
  $venv/bin/python -m pip install $add_args "$@"
}

# handle args
do_npm=0
do_python=0
do_go=0
do_binary=0
verbose=0
while [ $# -gt 0 ]; do
  case "$1" in
    "-h"|"--help")
      print_usage
      exit 0
      ;;
    "--npm")
      do_npm=1
      ;;
    "--python")
      do_python=1
      ;;
    "--go")
      do_go=1
      ;;
    "--binary")
      do_binary=1
      ;;
    "--all")
      do_npm=1
      do_binary=1
      do_go=1
      ;;
    "--verbose")
      verbose=1
      ;;
    *)
      print_usage
      exit 2
      ;;
  esac
  shift 1
done
if [ "$do_npm" -eq 0 ] && [ "$do_python" -eq 0 ] && [ "$do_go" -eq 0 ] && [ "$do_binary" -eq 0 ]; then
  print_usage
  exit 2
fi


vecho -n "check if NPM tools requested..."
if [ $do_npm -eq 1 ]; then
  vecho "yes"
  npm install -g \
    openapi3-generator \
    stylelint stylelint-config-standard \
    jsonlint \
    ibm-openapi-validator \
    @stoplight/spectral-cli \
    lighthouse \
    gulp

  for x in gulp openapi3-generator stylelint jsonlint lint-openapi spectral lighthouse; do
    if [ ! -f "$x" ]; then
      ln -s "npm-packages/bin/$x" "$x"
    fi
  done
else
  vecho "no"
fi

vecho -n "check if python tools requested..."
if [ $do_python -eq 1 ]; then
  vecho "yes"
  echo "ensure .venv-libcst is up to date"
  if [ ! -d .venv-libcst ]; then
    python -m venv .venv-libcst
  fi
  .venv-libcst/bin/pip install -U libcst
  echo ".venv-libcst done"
else
  vecho "no"
fi

vecho -n "check if Go tools requested..."
if [ $do_go -eq 1 ]; then
  vecho "yes"
  if ! command -v pinact; then
    go install github.com/suzuki-shunsuke/pinact/v4/cmd/pinact@latest
  fi
else
  vecho "no"
fi

vecho -n "check if binary tools requested..."
if [ $do_binary -eq 1 ]; then
  vecho "yes"

  if [ ! -f "vim-$VIM_VERSION" ]; then
    echo "vim v$VIM_VERSION detected missing, will install"
    curldown "https://github.com/vim/vim/archive/refs/tags/v${VIM_VERSION}.tar.gz" | \
      tar -xz
    pushd vim-$VIM_VERSION/src
    LDFLAGS="-rdynamic" ./configure \
      --with-features=huge \
      --enable-python3interp=dynamic \
      --prefix "$HOME/bin/.vim9"
    make
    make install
    popd
    rm -r vim-$VIM_VERSION
    ln -s .vim9/bin/vim vim-$VIM_VERSION
    rm -f vim
    ln -s vim-$VIM_VERSION vim
    echo "vim install done"
  fi

  if [ ! -f zed ]; then
    echo "zed detected missing, will install"
    mkdir .zed
    curldown "https://zed.dev/api/releases/stable/latest/zed-linux-x86_64.tar.gz" | \
      tar -xz -C .zed
    # link the zed binary to ~/.local/bin (or another directory in your $PATH)
    ln -s .zed/zed.app/bin/zed zed
  fi

  if [ ! -d ".helix-$HELIX_VERSION" ]; then
    echo "helix v$HELIX_VERSION detected missing, will install"
    curldown --github-release "helix-editor/helix" \
      "${HELIX_VERSION}/helix-${HELIX_VERSION}-x86_64-linux.tar.xz" | \
      tar -xJ
    mv "helix-${HELIX_VERSION}-x86_64-linux" ".helix-${HELIX_VERSION}"
    ln -s .helix-${HELIX_VERSION}/hx hx
    echo "helix install done"
  fi

  if [ ! -f "fnm-$FNM_VERSION" ]; then
    echo "fnm v$FNM_VERSION detected missing, will install"
    curldown --github-release "Schniz/fnm" "v${FNM_VERSION}/fnm-linux.zip" \
      -o "fnm-${FNM_VERSION}.gz"
    gunzip "fnm-${FNM_VERSION}.gz"
    chmod +x "fnm-${FNM_VERSION}"
    echo "fnm install done"
  fi
  cp "fnm-$FNM_VERSION" fnm

  if [ ! -f "mlr" ]; then
    echo "mlr (miller) v$MILLER_VERSION detected missing, will install"
    curldown --github-release "johnkerl/miller" "v${MILLER_VERSION}/miller-${MILLER_VERSION}-linux-amd64.tar.gz" | \
      tar -xz
    mv "miller-${MILLER_VERSION}-linux-amd64/mlr" .
    rm -r "miller-${MILLER_VERSION}-linux-amd64"
    echo "mlr install done"
  fi

  if [ ! -f "yq-$YQ_VERSION" ]; then
    echo "yq v$YQ_VERSION detected missing, will install"
    curldown --github-release "mikefarah/yq" "v${YQ_VERSION}/yq_linux_amd64.tar.gz" | \
      tar xz
    mv yq_linux_amd64 yq-$YQ_VERSION
    ln -s yq-$YQ_VERSION yq
    mkdir -p ~/.local/share/man/man1/
    rm install-man-page.sh
    mv yq.1 ~/.local/share/man/man1
    echo "yq install done"
  fi

  if [ ! -f "eksctl" ]; then
    echo "eksctl detected missing, will install"
    curldown --github-release "weaveworks/eksctl" "latest/eksctl_$(uname -s)_amd64.tar.gz" | \
      tar -xz
    chmod +x eksctl
    echo "eksctl install done"
  fi

  if [ ! -f "shfmt-$SHFMT_VERSION" ]; then
    echo "shfmt v$SHFMT_VERSION detected missing, will install"
    curldown --github-release "mvdan/sh" \
      "v${SHFMT_VERSION}/shfmt_v${SHFMT_VERSION}_linux_amd64"
      "shfmt-$SHFMT_VERSION"
    chmod +x "shfmt-$SHFMT_VERSION"
    cp "shfmt-$SHFMT_VERSION" shfmt
    echo "shfmt install done"
  fi

  if [ ! -f "cheat-$CHEAT_VERSION" ]; then
    echo "cheat v$CHEAT_VERSION detected missing, will install"
    setup_tmpdir
    curldown --github-release "cheat/cheat" "$CHEAT_VERSION/cheat-linux-amd64.gz" "$TMPDIR/cheat.gz"
    gunzip -c "$TMPDIR/cheat.gz" > "cheat-$CHEAT_VERSION"
    chmod +x "cheat-$CHEAT_VERSION"
    cp "cheat-$CHEAT_VERSION" cheat
    echo "cheat install done"
  fi

  if [ ! -f "shellcheck-$SHELLCHECK_VERSION" ]; then
    echo "shellcheck v$SHELLCHECK_VERSION detected missing, will install"
    setup_tmpdir
    curldown --github-release "koalaman/shellcheck" \
      "v${SHELLCHECK_VERSION}/shellcheck-v${SHELLCHECK_VERSION}.linux.x86_64.tar.xz" \
      "$TMPDIR/shellcheck.tar.xz"
    tar -xf "$TMPDIR/shellcheck.tar.xz" -C "$TMPDIR"
    mv "$TMPDIR/shellcheck-v${SHELLCHECK_VERSION}/shellcheck" "shellcheck-$SHELLCHECK_VERSION"
    cp "shellcheck-$SHELLCHECK_VERSION" shellcheck
    echo "shellcheck install done"
  fi

  if [ ! -f "gh-$GH_VERSION" ]; then
    echo "gh v$GH_VERSION detected missing, will install"
    setup_tmpdir
    curldown --github-release "cli/cli" "v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
      "$TMPDIR/gh.tar.gz"
    tar -xzf "$TMPDIR/gh.tar.gz" -C "$TMPDIR"
    mv "$TMPDIR/gh_${GH_VERSION}_linux_amd64/bin/gh" "gh-$GH_VERSION"
    cp "gh-$GH_VERSION" gh
    echo "gh install done"
  fi

  # kubectl/helm
  if [ ! -f "kubectl-$KUBECTL_VERSION" ]; then
    echo "kubectl v$KUBECTL_VERSION detected missing, will install"
    curldown "https://dl.k8s.io/release/v$KUBECTL_VERSION/bin/linux/amd64/kubectl" \
      "kubectl-$KUBECTL_VERSION"
    chmod +x "kubectl-$KUBECTL_VERSION"
    cp "kubectl-$KUBECTL_VERSION" kubectl
    echo "kubectl install done"
  fi
  if [ ! -f "helm-$HELM_VERSION" ]; then
    echo "helm v$HELM_VERSION detected missing, will install"
    setup_tmpdir
    curldown "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
      "$TMPDIR/helm.tar.gz"
    tar -xzf "$TMPDIR/helm.tar.gz" -C "$TMPDIR"
    mv "$TMPDIR/linux-amd64/helm" "helm-$HELM_VERSION"
    cp "helm-$HELM_VERSION" helm
    echo "helm install done"
  fi

  if [ ! -f "turbolift-$TURBOLIFT_VERSION" ]; then
    echo "turbolift v$TURBOLIFT_VERSION detected missing, will install"
    setup_tmpdir
    curldown --github-release "Skyscanner/turbolift" "${TURBOLIFT_VERSION}/turbolift_${TURBOLIFT_VERSION}_Linux_x86_64.tar.gz" \
      "$TMPDIR/turbolift-v$TURBOLIFT_VERSION.tar.gz"
    tar -xzf "$TMPDIR/turbolift-v$TURBOLIFT_VERSION.tar.gz" -C "$TMPDIR"
    mv "$TMPDIR/turbolift" "turbolift-$TURBOLIFT_VERSION"
    cp "turbolift-$TURBOLIFT_VERSION" turbolift
    echo "turbolift install done"
  fi

  if [ ! -f terraform-$TERRAFORM_VERSION ]; then
    echo "terraform v$TERRAFORM_VERSION detected missing, will install"
    setup_tmpdir
    curldown "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip" \
      "$TMPDIR/terraform-v$TERRAFORM_VERSION.zip" \
    unzip "$TMPDIR/terraform-v$TERRAFORM_VERSION.zip" -d "$TMPDIR"
    mv "$TMPDIR/terraform" "terraform-$TERRAFORM_VERSION"
    cp "terraform-$TERRAFORM_VERSION" terraform
    echo "terraform install done"
  fi

  if [ ! -f vale-$VALE_VERSION ]; then
    echo "vale v$VALE_VERSION detected missing, will install"
    setup_tmpdir
    curldown --github-release "errata-ai/vale" \
      "v${VALE_VERSION}/vale_${VALE_VERSION}_Linux_64-bit.tar.gz" \
      "$TMPDIR/vale-v$VALE_VERSION.tar.gz"
    tar -xzf "$TMPDIR/vale-v$VALE_VERSION.tar.gz" -C "$TMPDIR"
    mv "$TMPDIR/vale" "vale-$VALE_VERSION"
    cp "vale-$VALE_VERSION" vale
    echo "vale install done"
  fi

  if [ ! -f spotifyd-$SPOTIFYD_VERSION ]; then
    echo "spotifyd v${SPOTIFYD_VERSION} detected missing, will install"
    setup_tmpdir
    curldown --github-release "Spotifyd/spotifyd" \
      "v${SPOTIFYD_VERSION}/spotifyd-linux-x86_64-default.tar.gz" \
      "$TMPDIR/spotifyd-v${SPOTIFYD_VERSION}.tar.gz"
    tar -xzf "$TMPDIR/spotifyd-v$SPOTIFYD_VERSION.tar.gz" -C "$TMPDIR"
    mv "$TMPDIR/spotifyd" "spotifyd-$SPOTIFYD_VERSION"
    cp "spotifyd-$SPOTIFYD_VERSION" spotifyd
    chmod +x spotifyd
    cat > ~/.config/systemd/user/spotifyd.service << EOH
[Unit]
Description=A spotify playing daemon
Documentation=https://github.com/Spotifyd/spotifyd
Wants=sound.target
After=sound.target
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/home/sirosen/bin/spotifyd --no-daemon
Restart=always
RestartSec=12

[Install]
WantedBy=default.target
EOH
    echo "spotifyd install done (systemd unit may need a reload)"
  fi

  if [ ! -f typst-$TYPST_VERSION ]; then
    echo "typst v${TYPST_VERSION} detected missing, will install"
    setup_tmpdir

    curldown --github-release "typst/typst" \
      "v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" \
      "$TMPDIR/typst.tar.xz"

    tar -xJf "$TMPDIR/typst.tar.xz" -C "$TMPDIR"
    mv "$TMPDIR/typst-x86_64-unknown-linux-musl/typst" "typst-${TYPST_VERSION}"
    cp "typst-${TYPST_VERSION}" typst
    chmod +x typst

    echo "typst install done"
  fi

  if [ ! -f "sbx-$DOCKER_SANDBOX_VERSION" ]; then
    echo "sbx v${DOCKER_SANDBOX_VERSION} detected missing, will install"
    setup_tmpdir

    curldown --github-release "docker/sbx-releases" \
      "v${DOCKER_SANDBOX_VERSION}/DockerSandboxes-linux.tar.gz" \
      "$TMPDIR/sbx.tar.gz"
    tar -xzf "$TMPDIR/sbx.tar.gz" -C "$TMPDIR"
    mv "$TMPDIR/docker-sbx/sbx" "sbx-${DOCKER_SANDBOX_VERSION}"
    cp "sbx-${DOCKER_SANDBOX_VERSION}" "sbx"

    echo "sbx install done"
  fi

else
  vecho "no"
fi
